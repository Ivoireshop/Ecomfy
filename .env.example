# Copier vers .env (non versionné). Un seul projet par environnement :
#   prod = yfggrceynzcwklbxhgix   dev = xfpbpxncserliskrbaim
VITE_SUPABASE_PROJECT_ID=""
VITE_SUPABASE_URL=""
VITE_SUPABASE_PUBLISHABLE_KEY=""

VITE_VAPID_PUBLIC_KEY=""

# URL publique de l'application, utilisée pour les liens dans les mails (Edge Functions).
# Local : `supabase functions serve --env-file .env`. Déployé : `supabase secrets set APP_URL=https://ecomfy.cloud`
APP_URL="https://ecomfy.cloud"

# Garde-fou d'envoi des mails (Edge Functions) : live (défaut) | redirect | off
#   redirect : tout part vers EMAIL_REDIRECT_TO, sujet préfixé par le destinataire d'origine
#   off      : aucun mail livré (log seulement)
# Déployé : supabase secrets set EMAIL_MODE=redirect EMAIL_REDIRECT_TO=vous@exemple.com
EMAIL_MODE="live"
EMAIL_REDIRECT_TO=""
